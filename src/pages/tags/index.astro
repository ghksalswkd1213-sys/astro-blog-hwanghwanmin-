---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 전체 태그 목록 (글 수 많은 순).
const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko')
);
---
<BaseLayout title="태그" description="태그별 글 모음">
  <div class="container">
    <section class="hero">
      <h1>태그</h1>
      <p>{tags.length}개의 태그</p>
    </section>

    {tags.length > 0 ? (
      <div class="tag-cloud">
        {tags.map(([tag, count]) => (
          <a class="tag tag-lg" href={`/tags/${tag}/`}>#{tag} <span class="tag-count">{count}</span></a>
        ))}
      </div>
    ) : (
      <p class="post-excerpt">아직 태그가 없습니다.</p>
    )}
  </div>
</BaseLayout>
