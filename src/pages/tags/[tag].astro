---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 태그별 글 목록. 각 고유 태그마다 정적 페이지를 생성한다.
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`#${tag}`} description={`'${tag}' 태그가 붙은 글 모음`}>
  <div class="container">
    <section class="hero">
      <h1>#{tag}</h1>
      <p>{posts.length}개의 글</p>
    </section>

    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            {post.data.tags.length > 0 && (
              <span class="tags">
                {post.data.tags.map((t) => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}
              </span>
            )}
          </div>
          <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          {post.data.description && <p class="post-excerpt">{post.data.description}</p>}
        </li>
      ))}
    </ul>

    <a href="/tags/" class="back-link">← 전체 태그</a>
  </div>
</BaseLayout>
